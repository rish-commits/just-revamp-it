{
  "$meta": {
    "generator": "just-revamp-it/palette.mjs",
    "accent": "#7c3aed",
    "themes": [
      "light"
    ]
  },
  "color": {
    "light": {
      "accent": "#7c3aed",
      "accentUi": "#7c3aed",
      "accentDeep": "#4f00a6",
      "ramp": [
        "#6e27d9",
        "#7c3aed",
        "#8c5cf6",
        "#a68cfa",
        "#c3b5fd"
      ],
      "rampInk": [
        "#ffffff",
        "#ffffff",
        "#171717",
        "#171717",
        "#171717"
      ],
      "heat": {
        "min": 0.12,
        "max": 0.76,
        "ink": "#171717",
        "deadBand": [
          0.8,
          0.87
        ]
      },
      "funnel": {
        "from": "#6e27d9",
        "to": "#a68cfa",
        "breakOpacity": 0.4
      },
      "delta": {
        "positive": "#059669",
        "negative": "#e11d48",
        "neutral": "#6b7280"
      },
      "neutral": {
        "canvas": "#fafafa",
        "surface": "#ffffff",
        "foreground": "#171717",
        "muted": "#6b7280",
        "border": "rgba(0,0,0,0.06)"
      },
      "tints": {
        "hover": "color-mix(in oklab, #7c3aed 8%, transparent)",
        "selection": "color-mix(in oklab, #7c3aed 18%, transparent)",
        "track": "rgba(0,0,0,0.04)"
      }
    }
  },
  "type": {
    "scale": {
      "caption": "12px",
      "body": "14px",
      "label": "13px",
      "value": "24px",
      "display": "36px"
    },
    "weight": {
      "medium": 500,
      "semibold": 600
    },
    "tracking": {
      "tight": "-0.025em",
      "normal": "0"
    },
    "family": {
      "sans": "system-ui, sans-serif",
      "mono": "ui-monospace, monospace"
    },
    "measure": "75ch"
  },
  "space": [
    "2px",
    "4px",
    "6px",
    "8px",
    "10px",
    "12px",
    "16px",
    "20px",
    "24px",
    "32px"
  ],
  "rhythm": {
    "tight": "16px",
    "continuation": "16px",
    "section": "32px"
  },
  "radius": {
    "mark": "6px",
    "control": "8px",
    "card": "16px",
    "pill": "9999px"
  },
  "grid": {
    "measure": "72rem",
    "gutter": "16px",
    "pagePadX": "16px",
    "pagePadY": "32px"
  },
  "row": {
    "height": "28px",
    "gap": "8px",
    "trackRadius": "6px",
    "minFillPct": 1.5,
    "inFillLabelPct": 8
  },
  "chart": {
    "gridlines": 4,
    "strokePrimary": 2.25,
    "strokeSecondary": 1.75,
    "strokeGrid": 1,
    "areaOpacity": 0.1,
    "smoothTension": 0.18,
    "sparkline": {
      "w": 120,
      "h": 34,
      "dot": 2.25
    }
  },
  "z": {
    "stickyCell": 10,
    "stickyHeader": 20,
    "chartTooltip": 30,
    "tooltip": 40,
    "modal": 50
  },
  "border": {
    "hairline": "rgba(0,0,0,0.06)",
    "row": "rgba(0,0,0,0.05)",
    "strong": "rgba(0,0,0,0.10)"
  },
  "motion": {
    "transition": "color, background-color, border-color",
    "allowedAnimations": [
      "spin",
      "pulse"
    ]
  }
}
